#include <iostream>
using namespace std;

int main() {

    bool rooms[5] = {0};

    int choice, room;

    do {

        cout << "\n1.Book\n2.Show Rooms\n0.Exit\n";
        cin >> choice;

        switch(choice) {

            case 1:
                cin >> room;

                if(!rooms[room - 1]) {
                    rooms[room - 1] = true;
                    cout << "Booked!\n";
                }
                else {
                    cout << "Already booked!\n";
                }

                break;

            case 2:

                for(int i = 0; i < 5; i++) {

                    cout << "Room "
                         << i + 1
                         << ": "
                         << (rooms[i] ? "Booked" : "Free")
                         << endl;
                }

                break;
        }

    } while(choice != 0);

    return 0;
}
