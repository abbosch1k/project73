#include <iostream>
using namespace std;

int main() {

    string cars[5] = {
        "BMW",
        "Mercedes",
        "Toyota",
        "Kia",
        "Tesla"
    };

    bool rented[5] = {0};

    int choice;

    do {

        cout << "\n=== CAR RENTAL SYSTEM ===\n";
        cout << "1. Show Cars\n";
        cout << "2. Rent Car\n";
        cout << "0. Exit\n";
        cin >> choice;

        switch(choice) {

            case 1:

                for(int i = 0; i < 5; i++) {

                    cout << i + 1 << ". "
                         << cars[i];

                    if(rented[i])
                        cout << " (Rented)";

                    cout << endl;
                }

                break;

            case 2: {

                int car;

                cout << "Choose car number: ";
                cin >> car;

                if(!rented[car - 1]) {

                    rented[car - 1] = true;

                    cout << "Car rented successfully!\n";
                }
                else {

                    cout << "Car already rented!\n";
                }

                break;
            }
        }

    } while(choice != 0);

    return 0;
}
